import { useEffect } from "react";
import axios from 'axios'

const baseURL = 'http://localhost:3001/persons' 

const getAll = () => axios.get(baseURL).then(resp => resp.data)

const create = newPerson => axios.post(baseURL, newPerson).then(resp => resp.data)

const deletePerson = id => {
    console.log(`deleting person id: ${id}`)
    return axios.delete(`${baseURL}/${id}`).then(resp => resp.data)
}

export default {getAll, create, deletePerson}